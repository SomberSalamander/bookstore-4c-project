<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookstoreWebApplication.WebMvcApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/BookstoreWebApplication.WebMvcApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stylesheet.css" />
</head>
<body>
    <div class="banner-project background-accent">
        BookstoreWebApplication.WebMvcApp - Welcome @User.FindFirst("email").Value
    </div>
    <header class="banner-title mb-5">
        <span class="title text-accent">
            Book e-shop
        </span>
        <span class="imgs">
            <a class="dropdown-item" asp-controller="Books" asp-action="AdminList">
                @if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <span class="badge rounded-pill text-bg-dark">Admin</span>
                }
                else if (User?.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="badge rounded-pill text-bg-secondary">User</span>
                }
            </a>
            
            <div class="dropdown">
                <a class="dropdown-toggle text-decoration-none" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="fs-5 fw-medium text-accent">@User.FindFirst("email").Value  </span>
                    <img class="user-icon" src="~/img/userIcon.png" alt="@User.FindFirst("email").Value" />
                </a>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                    @if (User?.Identity == null && !User.Identity.IsAuthenticated)
                    {
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="Register">Register</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="Login">Login</a></li>
                    }
                    else
                    {
                        <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                    }
                </ul>
            </div>

            <a asp-area="" asp-controller="Books" asp-action="Cart">
                <img class="cart-icon" src="~/img/cartIcon.png" alt="Cart" />
            </a>
        </span>
    </header>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    
    <footer class="background-accent banner-project fixed-bottom">
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
